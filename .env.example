# Copy to .env and fill in. Never commit the real .env file.
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=research.example.edu,localhost
CSRF_TRUSTED_ORIGINS=https://research.example.edu
SITE_URL=https://research.example.edu
SITE_NAME=Research Tracker
INSTITUTION_NAME=University of Petra
INSTITUTION_NAME_AR=جامعة البترا
INSTITUTION_UNIT=Faculty Research Workspace
INSTITUTION_UNIT_AR=منصة متابعة البحث العلمي
TIME_ZONE=Asia/Amman
LANGUAGE_CODE=en

# Database (PostgreSQL recommended in production; SQLite is used if empty)
DATABASE_URL=postgres://tracker:tracker@db:5432/tracker

# Sign-up: set to 0 to allow joining by invitation only
ALLOW_SIGNUP=1

# Email (SMTP). Works with Gmail/Outlook app passwords, Amazon SES, Brevo, Resend SMTP, or your university server.
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=you@example.edu
EMAIL_HOST_PASSWORD=app-password
DEFAULT_FROM_EMAIL=Research Tracker <you@example.edu>

# Days before a deadline at which reminders go out
DEFAULT_REMINDER_DAYS=14,7,3,1,0

# Shared secret for the /cron/<job>/ endpoint used by GitHub Actions or other schedulers
CRON_SECRET=another-long-random-string
